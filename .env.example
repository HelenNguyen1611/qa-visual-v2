# Figma personal access token (Figma → Settings → Security → Personal access tokens)
FIGMA_TOKEN=

# AI for design comparison. Provider: openrouter | openai | anthropic | none
QA_AI_PROVIDER=openrouter
# Một key, hoặc nhiều key (cách nhau bằng dấu phẩy). Hết credit thì tự chuyển key tiếp theo.
# OPENROUTER_API_KEY=sk-or-v1-aaa,sk-or-v1-bbb
# Hoặc đánh số: OPENROUTER_API_KEY_2=…  OPENROUTER_API_KEY_3=…
OPENROUTER_API_KEY=
QA_AI_MODEL=google/gemini-3.7-flash

# Optional: use an existing Chrome instead of Playwright's download
# QA_CHROME_PATH=

# Keep these query keys from the seed URL on every discovered page (comma-separated).
# Tracking params are still stripped. Leave unset to strip all query (default).
# Example: http://site/?qa-showcase=1 → http://site/about/?qa-showcase=1
# QA_PRESERVE_QUERY=qa-showcase

