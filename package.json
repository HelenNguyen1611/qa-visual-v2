{
  "name": "qa-visual",
  "version": "2.0.0",
  "description": "One command: screenshot a site at 3 viewports, compare against the Figma design and the last approved run, find the width where layout breaks. One HTML report.",
  "type": "module",
  "bin": {
    "qa-visual": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/geometry",
    "check": "node dist/cli.js",
    "postinstall": "playwright install chromium",
    "start": "node dist/server.js",
    "web": "node dist/server.js",
    "share": "node dist/share.js",
    "models": "node dist/models.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.0"
  }
}
